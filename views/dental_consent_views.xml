<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_consent_list" model="ir.ui.view">
        <field name="name">dental.consent.list</field>
        <field name="model">dental.consent</field>
        <field name="arch" type="xml">
            <list string="Consents" multi_edit="1">
                <field name="patient_id"/>
                <field name="consent_type"/>
                <field name="signed_date"/>
                <field name="state"/>
                <field name="signed_by"/>
            </list>
        </field>
    </record>

    <record id="view_dental_consent_form" model="ir.ui.view">
        <field name="name">dental.consent.form</field>
        <field name="model">dental.consent</field>
        <field name="arch" type="xml">
            <form string="Consent">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,signed"/>
                </header>
                <sheet>
                    <group>
                        <group string="Consent">
                            <field name="patient_id" invisible="context.get('default_patient_id')"/>
                            <field name="consent_type"/>
                            <field name="description" placeholder="Describe what was explained to the patient"/>
                        </group>
                        <group string="Signing">
                            <field name="signed_date"/>
                            <field name="expiry_date"/>
                            <field name="signed_by" placeholder="Full name of person signing"/>
                            <field name="relationship" placeholder="e.g. Self, Parent, Guardian"/>
                        </group>
                    </group>
                    <group string="Signature">
                        <field name="signature" widget="signature"/>
                        <field name="signature_name" placeholder="Type the name to confirm signature"/>
                    </group>
                    <group>
                        <group string="Witness">
                            <field name="dentist_id"/>
                            <field name="witness_id"/>
                        </group>
                        <group string="Notes">
                            <field name="notes" placeholder="Additional notes about this consent"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dental_consent" model="ir.actions.act_window">
        <field name="name">Consents</field>
        <field name="res_model">dental.consent</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
