<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_history_list" model="ir.ui.view">
        <field name="name">dental.history.list</field>
        <field name="model">dental.history</field>
        <field name="arch" type="xml">
            <list string="Dental History" multi_edit="1">
                <field name="patient_id"/>
                <field name="tooth_number"/>
                <field name="condition"/>
                <field name="arch"/>
                <field name="quadrant"/>
                <field name="date"/>
                <field name="treatment"/>
                <field name="dentist_id"/>
            </list>
        </field>
    </record>

    <record id="view_dental_history_form" model="ir.ui.view">
        <field name="name">dental.history.form</field>
        <field name="model">dental.history</field>
        <field name="arch" type="xml">
            <form string="Dental History">
                <sheet>
                    <group>
                        <group string="Tooth Info">
                            <field name="patient_id" invisible="context.get('default_patient_id')"/>
                            <field name="tooth_number" placeholder="e.g. 11, 26, 36"/>
                            <field name="date"/>
                        </group>
                        <group string="Condition">
                            <field name="condition"/>
                            <field name="arch" readonly="1"/>
                            <field name="quadrant" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Treatment">
                            <field name="treatment" placeholder="e.g. Composite filling, Root canal"/>
                            <field name="dentist_id"/>
                        </group>
                        <group string="Notes">
                            <field name="notes" placeholder="e.g. Patient reports sensitivity, additional observations"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dental_history" model="ir.actions.act_window">
        <field name="name">Dental History</field>
        <field name="res_model">dental.history</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
