<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_tooth_tree" model="ir.ui.view">
        <field name="name">dental.tooth.tree</field>
        <field name="model">dental.tooth</field>
        <field name="arch" type="xml">
            <list string="Teeth">
                <field name="patient_id"/>
                <field name="tooth_number"/>
            </list>
        </field>
    </record>

    <record id="view_dental_tooth_form" model="ir.ui.view">
        <field name="name">dental.tooth.form</field>
        <field name="model">dental.tooth</field>
        <field name="arch" type="xml">
            <form string="Tooth">
                <sheet>
                    <group>
                        <field name="patient_id"/>
                        <field name="tooth_number"/>
                    </group>
                    <group string="Surfaces">
                        <field name="surface_ids">
                            <list>
                                <field name="surface"/>
                                <field name="condition"/>
                                <field name="treatment"/>
                                <field name="date"/>
                            </list>
                            <form>
                                <group>
                                    <field name="surface"/>
                                    <field name="condition"/>
                                    <field name="treatment"/>
                                    <field name="notes"/>
                                    <field name="date"/>
                                </group>
                            </form>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dental_tooth" model="ir.actions.act_window">
        <field name="name">Teeth</field>
        <field name="res_model">dental.tooth</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_dental_tooth_surface_tree" model="ir.ui.view">
        <field name="name">dental.tooth.surface.tree</field>
        <field name="model">dental.tooth.surface</field>
        <field name="arch" type="xml">
            <list string="Tooth Surfaces">
                <field name="tooth_id"/>
                <field name="surface"/>
                <field name="condition"/>
                <field name="treatment"/>
                <field name="date"/>
            </list>
        </field>
    </record>

    <record id="view_dental_tooth_surface_form" model="ir.ui.view">
        <field name="name">dental.tooth.surface.form</field>
        <field name="model">dental.tooth.surface</field>
        <field name="arch" type="xml">
            <form string="Tooth Surface">
                <sheet>
                    <group>
                        <field name="tooth_id"/>
                        <field name="surface"/>
                        <field name="condition"/>
                        <field name="treatment"/>
                        <field name="notes"/>
                        <field name="date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
