<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_condition_list" model="ir.ui.view">
        <field name="name">dental.condition.list</field>
        <field name="model">dental.condition</field>
        <field name="arch" type="xml">
            <list string="Conditions">
                <field name="code"/>
                <field name="name"/>
                <field name="color" widget="color" optional="hide"/>
                <field name="apply_to_whole_tooth" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_dental_condition_form" model="ir.ui.view">
        <field name="name">dental.condition.form</field>
        <field name="model">dental.condition</field>
        <field name="arch" type="xml">
            <form string="Condition">
                <sheet>
                    <group>
                        <group string="Condition Info">
                            <field name="code"/>
                            <field name="name"/>
                        </group>
                        <group string="Chart Display">
                            <field name="color" widget="color"/>
                            <field name="apply_to_whole_tooth" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dental_condition" model="ir.actions.act_window">
        <field name="name">Conditions</field>
        <field name="res_model">dental.condition</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first dental condition
            </p>
            <p>
                Manage dental chart conditions, their colors, and whether each
                applies to the whole tooth.
            </p>
        </field>
    </record>
</odoo>
