<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_medical_history_list" model="ir.ui.view">
        <field name="name">dental.medical.history.list</field>
        <field name="model">dental.medical.history</field>
        <field name="arch" type="xml">
            <list string="Medical History" multi_edit="1">
                <field name="patient_id"/>
                <field name="date"/>
                <field name="version"/>
                <field name="smoking" widget="boolean_toggle"/>
                <field name="alcohol_use" widget="boolean_toggle"/>
                <field name="pregnancy" widget="boolean_toggle"/>
                <field name="created_by"/>
            </list>
        </field>
    </record>

    <record id="view_dental_medical_history_form" model="ir.ui.view">
        <field name="name">dental.medical.history.form</field>
        <field name="model">dental.medical.history</field>
        <field name="arch" type="xml">
            <form string="Medical History">
                <sheet>
                    <group>
                        <group>
                            <field name="patient_id" invisible="context.get('default_patient_id')"/>
                            <field name="date"/>
                            <field name="version" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Health">
                            <group>
                                <field name="general_health" placeholder="Describe the patient's overall health status"/>
                                <field name="current_medication" placeholder="List all current medications and dosages"/>
                                <field name="medical_conditions" placeholder="e.g. Diabetes, Hypertension, Asthma"/>
                                <field name="allergies" placeholder="e.g. Penicillin, Latex, Sulfa drugs"/>
                            </group>
                        </page>
                        <page string="History">
                            <group>
                                <field name="previous_surgeries" placeholder="List any prior surgical procedures"/>
                                <field name="hospitalization" placeholder="Note any past hospital admissions"/>
                            </group>
                        </page>
                        <page string="Lifestyle">
                            <group>
                                <field name="smoking" widget="boolean_toggle"/>
                                <field name="alcohol_use" widget="boolean_toggle"/>
                                <field name="pregnancy" widget="boolean_toggle"/>
                                <field name="bruxism" widget="boolean_toggle"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Additional notes about medical history"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dental_medical_history" model="ir.actions.act_window">
        <field name="name">Medical History</field>
        <field name="res_model">dental.medical.history</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
