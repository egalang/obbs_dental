<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="obbs_dental.ToothDialog">
    <div class="o_dental_overlay" t-on-click="props.onClose">
        <div class="o_dental_dialog" t-on-click="(e) => e.stopPropagation()">
            <div class="o_dental_dialog_title">
                <span>Tooth #<t t-esc="props.toothNumber"/> — <t t-esc="surfaceLabel"/></span>
                <button type="button" class="o_dental_dialog_close" t-on-click="props.onClose">×</button>
            </div>
            <div class="o_dental_dialog_body">
                <div class="o_dental_field">
                    <label>Surface</label>
                    <div class="o_dental_surface_badge"><t t-esc="props.surface"/> — <t t-esc="surfaceLabel"/></div>
                </div>
                <div class="o_dental_field">
                    <label>Condition</label>
                    <select t-on-change="props.onConditionChange">
                        <option value="">-- Select --</option>
                        <t t-foreach="props.conditionOptions" t-as="opt" t-key="opt.code">
                            <option t-att-value="opt.code"
                                    t-att-selected="props.condition === opt.code"
                                    t-att-style="'color: ' + (opt.color || '#000')">
                                <t t-esc="opt.label"/>
                            </option>
                        </t>
                    </select>
                    <div class="o_dental_wholerooth_hint" t-if="props.wholeTooth">
                        <span class="legend-swatch" t-att-style="'background:' + selectedColor"/>
                        Applies to the entire tooth (all surfaces)
                    </div>
                </div>
                <div class="o_dental_field">
                    <label>Treatment</label>
                    <input type="text" t-att-value="props.treatment"
                           t-on-change="props.onTreatmentChange"
                           placeholder="e.g. Composite filling"/>
                </div>
                <div class="o_dental_field">
                    <label>Notes</label>
                    <textarea rows="2" t-att-value="props.notes"
                              t-on-change="props.onNotesChange"
                              placeholder="Optional notes"/>
                </div>
            </div>
            <div class="o_dental_dialog_footer">
                <button type="button" class="o_dental_btn o_dental_btn_secondary" t-on-click="props.onClose">Cancel</button>
                <button type="button" class="o_dental_btn o_dental_btn_primary" t-on-click="props.onSave">Save</button>
            </div>
        </div>
    </div>
</t>

</templates>
