<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_dental" model="ir.module.category">
            <field name="name">Dental</field>
            <field name="description">Dental Management</field>
            <field name="sequence">10</field>
        </record>

        <record id="res_groups_privilege_dental" model="res.groups.privilege">
            <field name="name">Dental</field>
            <field name="category_id" ref="module_category_dental"/>
        </record>

        <record id="group_dental_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_dental"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
            <field name="comment">Full access to dental management features</field>
        </record>

        <record id="group_dental_assistant" model="res.groups">
            <field name="name">Assistant</field>
            <field name="privilege_id" ref="res_groups_privilege_dental"/>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Limited write access to dental records</field>
        </record>
    </data>
</odoo>
